DB_USER=devradar
DB_PASSWORD=change_me
DB_NAME=devradar

# Cổng phía máy host (bên trong container vẫn là 5432 / 8080).
# Đổi nếu máy đã có app khác dùng cổng này, ví dụ DB_PORT=5433, BACKEND_PORT=8081.
DB_PORT=5432
BACKEND_PORT=8080

# Chuỗi bí mật ký JWT – đặt chuỗi ngẫu nhiên dài (>= 32 ký tự)
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min
# Token GitHub (Settings > Developer settings > Personal access tokens), có thể để trống
GITHUB_TOKEN=
# Địa chỉ AI engine, để trống khi chưa chạy AI engine (ví dụ http://ai-engine:8000)
AI_ENGINE_URL=
# Bật cron job lấy dữ liệu GitHub / kiểm tra release
ENABLE_SCHEDULER=true

LLM_API_KEY=
