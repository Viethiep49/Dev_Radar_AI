# Database (PostgreSQL + pgvector)
DB_USER=devradar
DB_PASSWORD=change_me
DB_NAME=devradar

# Host ports (inside the containers they stay 5432 / 8080).
# Change them if another app already uses these ports, e.g. DB_PORT=5433, BACKEND_PORT=8081.
DB_PORT=5432
BACKEND_PORT=8080

# JWT signing secret – use a long random string (>= 32 characters)
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min

# GitHub token (Settings > Developer settings > Personal access tokens). Can be empty.
GITHUB_TOKEN=

# ---- Login with Google / GitHub (optional). Empty = that login is disabled ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Comma separated; put the *Web application* client ID first (Flutter uses it as serverClientId).
GOOGLE_CLIENT_IDS=
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# The secret stays on the backend; never put it in the mobile app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must be exactly the "Authorization callback URL" set in the GitHub OAuth App.
GITHUB_REDIRECT_URI=devradar://oauth/github

# Address of the AI engine. Leave empty to use the backend's fallback AI.
AI_ENGINE_URL=http://ai-engine:8000

# Enable cron jobs that fetch GitHub data / check releases
ENABLE_SCHEDULER=true

# AI engine (Ollama). GPU is required by default (see README): the target is a
# /chat answer under 30s. On a machine without a GPU use docker-compose.cpu.yml.
# Model to pull and use for summarize/chat
OLLAMA_MODEL=qwen2.5:7b
# Must stay below the backend AI_TIMEOUT_SECONDS (30s) so the backend does not time out first.
OLLAMA_TIMEOUT_SECONDS=25
# Minimum cosine similarity (0-1) for a document chunk to be used as chat context
MIN_SIMILARITY=0.35
